{
  "name": "@hugomrdias/vite-plugin-agent-skills",
  "version": "0.0.0",
  "description": "Vite plugin that publishes Agent Skills for agent skills discovery under /.well-known/agent-skills/",
  "license": "MIT",
  "author": "Hugo Dias <hugomrdias@gmail.com>",
  "homepage": "https://github.com/hugomrdias/fil/tree/main/packages/vite-plugin-agent-skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugomrdias/fil.git",
    "directory": "packages/vite-plugin-agent-skills"
  },
  "bugs": {
    "url": "https://github.com/hugomrdias/fil/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "client.d.ts",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
