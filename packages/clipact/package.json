{
  "name": "clipact",
  "version": "0.1.0",
  "description": "Small framework for Node.js CLIs that agents and humans can both rely on",
  "license": "MIT",
  "author": "Hugo Dias <hugomrdias@gmail.com>",
  "homepage": "https://github.com/hugomrdias/fil/tree/main/packages/clipact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugomrdias/fil.git",
    "directory": "packages/clipact"
  },
  "bugs": {
    "url": "https://github.com/hugomrdias/fil/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "4.6.5"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
