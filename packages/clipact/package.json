{
  "name": "clipact",
  "private": true,
  "version": "0.0.0",
  "description": "Small framework for Node.js CLIs that agents and humans can both rely on",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "4.6.5"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  }
}
